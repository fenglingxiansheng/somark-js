{
  "name": "somark-js",
  "version": "0.1.0",
  "description": "SoMark SDK + CLI — Document parsing, PDF processing, and SoMarkDown preview",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vendor/somarkdown-viewer/index.html",
    "vendor/somarkdown-viewer/lib",
    "vendor/somarkdown-viewer/style",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "somark": "./dist/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "somark",
    "pdf",
    "document",
    "parsing",
    "cli",
    "sdk"
  ],
  "author": "SoMark",
  "license": "Apache-2.0",
  "homepage": "https://somark.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoMarkAI/somark-js"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.12",
    "@types/pngjs": "^6.0.5",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "open": "^10.1.0",
    "ora": "^8.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
